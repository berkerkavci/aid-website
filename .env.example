# Copy to .env.local for local development and add the same keys in
# Vercel → Project → Settings → Environment Variables.

# Public URL of the site (used for canonical URLs, sitemap and Open Graph).
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=https://aidprojectsolutions.com

# Contact form e-mail delivery (https://resend.com).
# Without RESEND_API_KEY the form logs submissions in development and
# shows an error in production.
RESEND_API_KEY=
CONTACT_TO_EMAIL=bkavci@aidprojectsolutions.com
# Must be an address on a domain verified in Resend.
CONTACT_FROM_EMAIL="AID Website <noreply@aidprojectsolutions.com>"
